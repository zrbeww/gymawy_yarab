{
  "version": 2,
  "builds": [
    { "src": "frontend/api/**/*.ts", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "frontend/api/$1.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}


